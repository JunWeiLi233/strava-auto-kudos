{
  "manifest_version": 3,
  "name": "Strava Auto Kudos",
  "version": "2.2.0",
  "description": "Automatically gives kudos on Strava based on your filters. Zero-interaction after setup.",
  "homepage_url": "https://github.com/JunWeiLi233/strava-auto-kudos",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.strava.com/*"
  ],
  "action": {
    "default_title": "Strava Auto Kudos",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.strava.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
